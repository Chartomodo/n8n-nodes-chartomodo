{
	"name": "n8n-nodes-chartomodo",
	"version": "0.1.0",
	"description": "Push n8n data into ChartOmodo charts and read your charts back.",
	"license": "MIT",
	"homepage": "https://chartomodo.com/developers/api",
	"keywords": [
		"n8n-community-node-package",
		"chartomodo",
		"charts",
		"notion",
		"dashboard"
	],
	"author": {
		"name": "ChartOmodo",
		"email": "support@chartomodo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Chartomodo/n8n-nodes-chartomodo.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/package.json",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChartOmodoApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ChartOmodo/ChartOmodo.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
